# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Public (exposed to the browser) ----------

# Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base URL used in emails, .ics, embed and links.
# Local: http://localhost:3000 | Vercel: https://<project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Server only ----------

# Supabase secret key (bypasses RLS). Server jobs only.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Without a verified domain, Resend only delivers to the account owner's address.
EMAIL_FROM="Agenda Tech Resolute <onboarding@resend.dev>"

# Random secrets, 32+ chars. Generate with: openssl rand -base64 48
RATE_LIMIT_SALT=change-me-to-a-long-random-string-32-chars-min
CRON_SECRET=change-me-to-a-long-random-string-32-chars-min

# Demo host (created by the seed, used by "Entrar como anfitrião demo")
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me-demo-password
